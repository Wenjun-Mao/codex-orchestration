{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://private.local/codex-flow/task-disposition.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "kind", "disposition_id", "run_id",
    "runtime_context_digest", "configuration_digest", "repository_id", "common_dir",
    "coordinator_binding", "plan_id", "revision_digest", "task_id", "task_digest",
    "contract_id", "operation_id", "release_id", "executor_thread_id",
    "callback_id", "receipt_digest", "decision", "reason", "integration_id",
    "verification_id", "verification_digest", "state", "prepared_at", "finalized_at",
    "callback_consumed_at"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "kind": { "const": "codex-flow-v06-task-disposition" },
    "disposition_id": { "$ref": "#/$defs/safeId" },
    "run_id": { "$ref": "#/$defs/safeId" },
    "runtime_context_digest": { "$ref": "#/$defs/digest" },
    "configuration_digest": { "$ref": "#/$defs/digest" },
    "repository_id": { "$ref": "#/$defs/safeId" },
    "common_dir": { "$ref": "#/$defs/absolutePath" },
    "coordinator_binding": { "$ref": "#/$defs/coordinatorBinding" },
    "plan_id": { "$ref": "#/$defs/safeId" },
    "revision_digest": { "$ref": "#/$defs/digest" },
    "task_id": { "$ref": "#/$defs/safeId" },
    "task_digest": { "$ref": "#/$defs/digest" },
    "contract_id": { "$ref": "#/$defs/digest" },
    "operation_id": { "$ref": "#/$defs/safeId" },
    "release_id": { "$ref": "#/$defs/safeId" },
    "executor_thread_id": { "$ref": "#/$defs/threadId" },
    "callback_id": { "$ref": "#/$defs/nullableId" },
    "receipt_digest": { "$ref": "#/$defs/nullableDigest" },
    "decision": {
      "enum": ["accepted-no-change", "accepted-for-integration", "rejected", "retained-blocked", "cancelled"]
    },
    "reason": { "type": "string", "minLength": 1, "maxLength": 512 },
    "integration_id": { "$ref": "#/$defs/nullableId" },
    "verification_id": { "$ref": "#/$defs/nullableVerificationId" },
    "verification_digest": { "$ref": "#/$defs/nullableDigest" },
    "state": { "enum": ["prepared", "finalized", "completed"] },
    "prepared_at": { "$ref": "#/$defs/timestamp" },
    "finalized_at": { "$ref": "#/$defs/nullableTimestamp" },
    "callback_consumed_at": { "$ref": "#/$defs/nullableTimestamp" }
  },
  "$defs": {
    "safeId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_.-]+$"
    },
    "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "absolutePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048,
      "pattern": "^/"
    },
    "threadId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9_.-]+$"
    },
    "coordinatorBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lineage_id", "thread_id", "generation", "binding_digest"],
      "properties": {
        "lineage_id": { "$ref": "#/$defs/safeId" },
        "thread_id": { "$ref": "#/$defs/threadId" },
        "generation": { "type": "integer", "minimum": 1, "maximum": 2147483647 },
        "binding_digest": { "$ref": "#/$defs/digest" }
      }
    },
    "verificationId": {
      "type": "string",
      "pattern": "^verification-v1-[0-9a-f]{64}$"
    },
    "nullableId": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/safeId" }] },
    "nullableDigest": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/digest" }] },
    "nullableVerificationId": {
      "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/verificationId" }]
    },
    "nullableTimestamp": {
      "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/timestamp" }]
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "maxLength": 64
    }
  }
}
