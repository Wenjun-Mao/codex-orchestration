{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://private.local/codex-flow/cleanup-plan-v07.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "kind", "plan_id", "run_id", "run_status",
    "repository", "branch_fences", "items", "candidate_operation_ids",
    "blocking_operation_ids", "unbound_branch_fences", "blocking_branch_fences",
    "counts", "mutation_performed"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "kind": { "const": "codex-flow-v07-cleanup-plan" },
    "plan_id": {
      "type": "string",
      "pattern": "^cleanup-plan-v1-[0-9a-f]{64}$"
    },
    "run_id": { "$ref": "#/$defs/safeId" },
    "run_status": { "enum": ["active", "closed", "abandoned"] },
    "repository": { "$ref": "#/$defs/repository" },
    "branch_fences": {
      "type": "array",
      "maxItems": 128,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 512 }
    },
    "items": {
      "type": "array",
      "maxItems": 128,
      "items": { "$ref": "#/$defs/item" }
    },
    "candidate_operation_ids": {
      "type": "array",
      "maxItems": 128,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/safeId" }
    },
    "blocking_operation_ids": {
      "type": "array",
      "maxItems": 128,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/safeId" }
    },
    "unbound_branch_fences": {
      "type": "array",
      "maxItems": 128,
      "items": { "$ref": "#/$defs/unboundBranchFence" }
    },
    "blocking_branch_fences": {
      "type": "array",
      "maxItems": 128,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 512 }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "host_worktree_tasks", "unbound_branch_fences", "cleanup_required",
        "cleanup_candidates", "close_blocked"
      ],
      "properties": {
        "host_worktree_tasks": { "$ref": "#/$defs/count" },
        "unbound_branch_fences": { "$ref": "#/$defs/count" },
        "cleanup_required": { "$ref": "#/$defs/count" },
        "cleanup_candidates": { "$ref": "#/$defs/count" },
        "close_blocked": { "$ref": "#/$defs/count" }
      }
    },
    "mutation_performed": { "const": false }
  },
  "$defs": {
    "safeId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_.-]+$"
    },
    "nullableSafeId": {
      "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/safeId" }]
    },
    "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "revision": { "type": "string", "pattern": "^[0-9a-f]{40,64}$" },
    "nullableRevision": {
      "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/revision" }]
    },
    "nullableText": {
      "oneOf": [
        { "type": "null" },
        { "type": "string", "minLength": 1, "maxLength": 512 }
      ]
    },
    "nullablePath": {
      "oneOf": [
        { "type": "null" },
        { "type": "string", "minLength": 1, "maxLength": 2048 }
      ]
    },
    "count": { "type": "integer", "minimum": 0, "maximum": 128 },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository_id", "common_dir", "controller_root", "branch", "head"],
      "properties": {
        "repository_id": { "$ref": "#/$defs/digest" },
        "common_dir": { "type": "string", "minLength": 1, "maxLength": 2048 },
        "controller_root": { "type": "string", "minLength": 1, "maxLength": 2048 },
        "branch": { "type": "string", "minLength": 1, "maxLength": 256 },
        "head": { "$ref": "#/$defs/nullableRevision" }
      }
    },
    "localRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["exists", "tip"],
      "properties": {
        "exists": { "type": "boolean" },
        "tip": { "$ref": "#/$defs/nullableRevision" }
      }
    },
    "attachment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "head", "branch_ref", "detached", "bare", "locked", "prunable"],
      "properties": {
        "path": { "type": "string", "minLength": 1, "maxLength": 2048 },
        "head": { "$ref": "#/$defs/nullableRevision" },
        "branch_ref": { "$ref": "#/$defs/nullableText" },
        "detached": { "type": "boolean" },
        "bare": { "type": "boolean" },
        "locked": { "type": "boolean" },
        "prunable": { "type": "boolean" }
      }
    },
    "worktree": {
      "type": "object",
      "additionalProperties": false,
      "required": ["original_path", "original_path_state", "attachments"],
      "properties": {
        "original_path": { "$ref": "#/$defs/nullablePath" },
        "original_path_state": { "enum": ["not-recorded", "present", "absent"] },
        "attachments": {
          "type": "array",
          "maxItems": 128,
          "items": { "$ref": "#/$defs/attachment" }
        }
      }
    },
    "upstream": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expected", "configured", "remote_ref", "remote_exists", "remote_tip", "state"],
      "properties": {
        "expected": { "$ref": "#/$defs/nullableText" },
        "configured": { "$ref": "#/$defs/nullableText" },
        "remote_ref": { "$ref": "#/$defs/nullableText" },
        "remote_exists": { "type": "boolean" },
        "remote_tip": { "$ref": "#/$defs/nullableRevision" },
        "state": {
          "enum": [
            "not-declared", "local-ref-absent", "configured-mismatch",
            "remote-ref-missing", "tip-mismatch", "exact"
          ]
        }
      }
    },
    "unboundBranchFence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "branch", "ref", "local_ref", "worktree_attachments", "cleanup_required",
        "close_blocked", "reason_codes"
      ],
      "properties": {
        "branch": { "type": "string", "minLength": 1, "maxLength": 256 },
        "ref": { "type": "string", "minLength": 1, "maxLength": 512 },
        "local_ref": { "$ref": "#/$defs/localRef" },
        "worktree_attachments": {
          "type": "array",
          "maxItems": 128,
          "items": { "$ref": "#/$defs/attachment" }
        },
        "cleanup_required": { "type": "boolean" },
        "close_blocked": { "type": "boolean" },
        "reason_codes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["unbound-branch-fence-live", "unbound-branch-fence-resolved"] }
        }
      }
    },
    "disposition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision", "state"],
      "properties": {
        "decision": {
          "enum": [
            "accepted-for-integration", "accepted-no-change", "rejected",
            "retained-blocked", "cancelled"
          ]
        },
        "state": { "enum": ["prepared", "finalized", "completed"] }
      }
    },
    "archive": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "worktree_state"],
      "properties": {
        "state": {
          "enum": [
            "prepared", "accepted-awaiting-observation", "completed",
            "rejected-before-send", "ambiguous"
          ]
        },
        "worktree_state": {
          "oneOf": [
            { "type": "null" },
            { "enum": ["not-applicable", "absent"] }
          ]
        }
      }
    },
    "reasonCode": {
      "enum": [
        "archive-missing", "archive-not-completed", "archive-worktree-not-absent",
        "authority-conflict", "branch-attached-worktree",
        "branch-missing-with-live-upstream", "branch-tip-mismatch", "callback-missing",
        "callback-not-consumed", "cleanup-complete", "cleanup-ready",
        "creation-not-ready", "disposition-missing", "disposition-not-cleanup-eligible",
        "disposition-not-completed", "integration-missing", "integration-not-reconciled",
        "original-worktree-present", "release-missing", "release-not-accepted",
        "upstream-configured-mismatch", "upstream-ref-missing",
        "upstream-tip-mismatch"
      ]
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_id", "task_id", "operation_id", "release_id", "callback_id",
        "disposition_id", "integration_id", "archive_id", "executor_thread_id",
        "branch", "ref", "expected_tip", "local_ref", "worktree", "upstream",
        "disposition", "archive", "classification", "cleanup_required",
        "close_blocked", "candidate", "reason_codes"
      ],
      "properties": {
        "run_id": { "$ref": "#/$defs/safeId" },
        "task_id": { "$ref": "#/$defs/safeId" },
        "operation_id": { "$ref": "#/$defs/safeId" },
        "release_id": { "$ref": "#/$defs/nullableSafeId" },
        "callback_id": { "$ref": "#/$defs/nullableSafeId" },
        "disposition_id": { "$ref": "#/$defs/nullableSafeId" },
        "integration_id": { "$ref": "#/$defs/nullableSafeId" },
        "archive_id": { "$ref": "#/$defs/nullableSafeId" },
        "executor_thread_id": {
          "oneOf": [
            { "type": "null" },
            { "type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[A-Za-z0-9_.-]+$" }
          ]
        },
        "branch": { "type": "string", "minLength": 1, "maxLength": 256 },
        "ref": { "type": "string", "minLength": 1, "maxLength": 512 },
        "expected_tip": { "$ref": "#/$defs/nullableRevision" },
        "local_ref": { "$ref": "#/$defs/localRef" },
        "worktree": { "$ref": "#/$defs/worktree" },
        "upstream": { "$ref": "#/$defs/upstream" },
        "disposition": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/disposition" }]
        },
        "archive": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/archive" }]
        },
        "classification": {
          "enum": [
            "authority-conflict", "in-flight", "retained-visible",
            "awaiting-archive", "cleanup-blocked", "cleanup-ready", "clean"
          ]
        },
        "cleanup_required": { "type": "boolean" },
        "close_blocked": { "type": "boolean" },
        "candidate": { "type": "boolean" },
        "reason_codes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 24,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/reasonCode" }
        }
      }
    }
  }
}
