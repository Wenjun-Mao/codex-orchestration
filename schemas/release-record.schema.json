{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://private.local/codex-flow/release-record.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "kind", "release_id", "run_id",
    "runtime_context_digest", "configuration_digest", "repository_id",
    "common_dir", "coordinator_binding", "plan_id", "revision_digest",
    "task_id", "task_digest", "contract_id", "operation_id",
    "ready_thread_id", "worktree_binding_id", "task_contract", "prompt_digest", "prompt_length",
    "delivery", "acceptance", "prepared_at", "updated_at"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "kind": { "const": "codex-flow-v07-task-release" },
    "release_id": {
      "type": "string",
      "pattern": "^release-v1-[0-9a-f]{64}$"
    },
    "run_id": { "$ref": "#/$defs/safeId" },
    "runtime_context_digest": { "$ref": "#/$defs/digest" },
    "configuration_digest": { "$ref": "#/$defs/digest" },
    "repository_id": { "$ref": "#/$defs/safeId" },
    "common_dir": { "$ref": "#/$defs/absolutePath" },
    "coordinator_binding": { "$ref": "#/$defs/coordinatorBinding" },
    "plan_id": { "$ref": "#/$defs/safeId" },
    "revision_digest": { "$ref": "#/$defs/digest" },
    "task_id": { "$ref": "#/$defs/safeId" },
    "task_digest": { "$ref": "#/$defs/digest" },
    "contract_id": { "$ref": "#/$defs/digest" },
    "operation_id": { "$ref": "#/$defs/safeId" },
    "ready_thread_id": { "$ref": "#/$defs/safeId256" },
    "worktree_binding_id": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "string",
          "pattern": "^worktree-binding-v1-[0-9a-f]{64}$"
        }
      ]
    },
    "task_contract": {
      "$ref": "https://private.local/codex-flow/generated-task-contract.schema.json"
    },
    "prompt_digest": { "$ref": "#/$defs/digest" },
    "prompt_length": { "type": "integer", "minimum": 1, "maximum": 524288 },
    "delivery": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["outcome", "reconciled_at"],
          "properties": {
            "outcome": { "enum": ["sent", "rejected-before-send", "ambiguous"] },
            "reconciled_at": { "type": "string", "format": "date-time" }
          }
        }
      ]
    },
    "acceptance": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "ready_thread_id", "contract_id", "runtime_context_digest",
            "common_dir", "accepted_at"
          ],
          "properties": {
            "ready_thread_id": { "$ref": "#/$defs/safeId256" },
            "contract_id": { "$ref": "#/$defs/digest" },
            "runtime_context_digest": { "$ref": "#/$defs/digest" },
            "common_dir": { "$ref": "#/$defs/absolutePath" },
            "accepted_at": { "type": "string", "format": "date-time" }
          }
        }
      ]
    },
    "prepared_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "safeId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_.-]+$"
    },
    "safeId256": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9_.-]+$"
    },
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "absolutePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048,
      "pattern": "^/"
    },
    "coordinatorBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lineage_id", "thread_id", "generation", "binding_digest"],
      "properties": {
        "lineage_id": { "$ref": "#/$defs/safeId" },
        "thread_id": { "$ref": "#/$defs/safeId256" },
        "generation": { "type": "integer", "minimum": 1, "maximum": 2147483647 },
        "binding_digest": { "$ref": "#/$defs/digest" }
      }
    }
  }
}
