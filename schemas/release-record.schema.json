{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://private.local/codex-flow/release-record.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "kind", "release_id", "run_id", "plan_id",
    "revision_id", "task_id", "task_contract_digest", "operation_id",
    "ready_thread_id", "runtime_digest", "config_digest", "repository_id",
    "common_dir", "prompt_digest", "prompt_length", "delivery",
    "acceptance", "prepared_at", "updated_at"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "kind": { "const": "codex-flow-v06-task-release" },
    "release_id": { "$ref": "#/$defs/safeId" },
    "run_id": { "$ref": "#/$defs/safeId" },
    "plan_id": { "$ref": "#/$defs/safeId" },
    "revision_id": { "$ref": "#/$defs/safeId" },
    "task_id": { "$ref": "#/$defs/safeId" },
    "task_contract_digest": { "$ref": "#/$defs/digest" },
    "operation_id": { "$ref": "#/$defs/safeId" },
    "ready_thread_id": { "$ref": "#/$defs/safeId" },
    "runtime_digest": { "$ref": "#/$defs/digest" },
    "config_digest": { "$ref": "#/$defs/digest" },
    "repository_id": { "$ref": "#/$defs/safeId" },
    "common_dir": { "type": "string", "minLength": 1, "maxLength": 1024 },
    "prompt_digest": { "$ref": "#/$defs/digest" },
    "prompt_length": { "type": "integer", "minimum": 1, "maximum": 65536 },
    "delivery": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["outcome", "reconciled_at"],
          "properties": {
            "outcome": { "enum": ["sent", "rejected-before-send", "ambiguous"] },
            "reconciled_at": { "type": "string", "format": "date-time" }
          }
        }
      ]
    },
    "acceptance": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "executor_thread_id", "task_contract_digest", "runtime_digest",
            "common_dir", "accepted_at"
          ],
          "properties": {
            "executor_thread_id": { "$ref": "#/$defs/safeId" },
            "task_contract_digest": { "$ref": "#/$defs/digest" },
            "runtime_digest": { "$ref": "#/$defs/digest" },
            "common_dir": { "type": "string", "minLength": 1, "maxLength": 1024 },
            "accepted_at": { "type": "string", "format": "date-time" }
          }
        }
      ]
    },
    "prepared_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "safeId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_.-]+$"
    },
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
