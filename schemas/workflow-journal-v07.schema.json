{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://private.local/codex-flow/workflow-journal-v07.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "kind", "run_id", "plan_id", "current_revision",
    "current_revision_digest", "revisions", "contract_claims", "created_at",
    "updated_at", "journal_digest"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "kind": { "const": "codex-flow-v07-workflow-journal" },
    "run_id": { "$ref": "#/$defs/safeId" },
    "plan_id": { "$ref": "#/$defs/safeId" },
    "current_revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    },
    "current_revision_digest": { "$ref": "#/$defs/digest" },
    "revisions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": { "$ref": "#/$defs/revisionEntry" }
    },
    "contract_claims": {
      "type": "array",
      "maxItems": 4096,
      "items": { "$ref": "#/$defs/contractClaim" }
    },
    "created_at": { "$ref": "#/$defs/timestamp" },
    "updated_at": { "$ref": "#/$defs/timestamp" },
    "journal_digest": { "$ref": "#/$defs/digest" }
  },
  "$defs": {
    "safeId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_.-]+$"
    },
    "hostId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9_.-]+$"
    },
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "timestamp": {
      "type": "string",
      "maxLength": 64,
      "format": "date-time"
    },
    "nullableTimestamp": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/timestamp" }
      ]
    },
    "coordinatorBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lineage_id", "thread_id", "generation", "binding_digest"],
      "properties": {
        "lineage_id": { "$ref": "#/$defs/safeId" },
        "thread_id": { "$ref": "#/$defs/hostId" },
        "generation": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "binding_digest": { "$ref": "#/$defs/digest" }
      }
    },
    "revisionEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["revision", "revision_digest", "admitted_at"],
      "properties": {
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "revision_digest": { "$ref": "#/$defs/digest" },
        "admitted_at": { "$ref": "#/$defs/timestamp" }
      }
    },
    "contractClaim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "kind", "claim_id", "run_id", "runtime_context_digest",
        "configuration_digest", "repository_id", "common_dir", "coordinator_binding",
        "plan_id", "revision_digest", "task_id", "task_digest", "contract_id",
        "execution_kind", "state", "operation_kind", "operation_id", "claimed_at",
        "started_at", "terminal_at", "superseded_by_revision_digest", "revoked_at"
      ],
      "properties": {
        "schema_version": { "const": 1 },
        "kind": { "const": "codex-flow-v07-workflow-contract-claim" },
        "claim_id": {
          "type": "string",
          "pattern": "^workflow-contract-claim-v1-[0-9a-f]{64}$"
        },
        "run_id": { "$ref": "#/$defs/safeId" },
        "runtime_context_digest": { "$ref": "#/$defs/digest" },
        "configuration_digest": { "$ref": "#/$defs/digest" },
        "repository_id": { "$ref": "#/$defs/safeId" },
        "common_dir": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "coordinator_binding": { "$ref": "#/$defs/coordinatorBinding" },
        "plan_id": { "$ref": "#/$defs/safeId" },
        "revision_digest": { "$ref": "#/$defs/digest" },
        "task_id": { "$ref": "#/$defs/safeId" },
        "task_digest": { "$ref": "#/$defs/digest" },
        "contract_id": { "$ref": "#/$defs/digest" },
        "execution_kind": { "enum": ["task-thread", "subagent"] },
        "state": { "enum": ["current", "started", "terminal-no-object", "revoked"] },
        "operation_kind": {
          "enum": [null, "visible-task-creation", "subagent-operation"]
        },
        "operation_id": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/hostId" }
          ]
        },
        "claimed_at": { "$ref": "#/$defs/timestamp" },
        "started_at": { "$ref": "#/$defs/nullableTimestamp" },
        "terminal_at": { "$ref": "#/$defs/nullableTimestamp" },
        "superseded_by_revision_digest": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/digest" }
          ]
        },
        "revoked_at": { "$ref": "#/$defs/nullableTimestamp" }
      },
      "allOf": [
        {
          "if": { "properties": { "state": { "const": "current" } } },
          "then": {
            "properties": {
              "operation_kind": { "type": "null" },
              "operation_id": { "type": "null" },
              "started_at": { "type": "null" },
              "terminal_at": { "type": "null" },
              "superseded_by_revision_digest": { "type": "null" },
              "revoked_at": { "type": "null" }
            }
          }
        },
        {
          "if": { "properties": { "state": { "const": "started" } } },
          "then": {
            "properties": {
              "operation_kind": {
                "enum": ["visible-task-creation", "subagent-operation"]
              },
              "operation_id": { "$ref": "#/$defs/hostId" },
              "started_at": { "$ref": "#/$defs/timestamp" },
              "terminal_at": { "type": "null" },
              "superseded_by_revision_digest": { "type": "null" },
              "revoked_at": { "type": "null" }
            }
          }
        },
        {
          "if": { "properties": { "state": { "const": "terminal-no-object" } } },
          "then": {
            "properties": {
              "operation_kind": {
                "enum": ["visible-task-creation", "subagent-operation"]
              },
              "operation_id": { "$ref": "#/$defs/hostId" },
              "started_at": { "$ref": "#/$defs/timestamp" },
              "terminal_at": { "$ref": "#/$defs/timestamp" },
              "revoked_at": { "type": "null" }
            }
          }
        },
        {
          "if": { "properties": { "state": { "const": "revoked" } } },
          "then": {
            "properties": {
              "operation_kind": { "type": "null" },
              "operation_id": { "type": "null" },
              "started_at": { "type": "null" },
              "terminal_at": { "type": "null" },
              "superseded_by_revision_digest": { "type": "null" },
              "revoked_at": { "$ref": "#/$defs/timestamp" }
            }
          }
        },
        {
          "if": { "properties": { "execution_kind": { "const": "task-thread" } } },
          "then": {
            "properties": {
              "operation_kind": {
                "enum": [null, "visible-task-creation"]
              }
            }
          }
        },
        {
          "if": { "properties": { "execution_kind": { "const": "subagent" } } },
          "then": {
            "properties": {
              "operation_kind": {
                "enum": [null, "subagent-operation"]
              }
            }
          }
        }
      ]
    }
  }
}
