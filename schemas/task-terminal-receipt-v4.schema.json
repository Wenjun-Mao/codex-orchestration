{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://private.local/codex-flow/task-terminal-receipt-v4.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "kind", "recipient", "executor_thread_id", "run_id",
    "runtime_context_digest", "configuration_digest", "repository_id", "common_dir",
    "plan_id", "revision_digest", "task_id", "task_digest", "contract_id",
    "operation_id", "release_id", "task_launch", "classification", "git_outcome",
    "model_evidence", "result_or_blocker", "next_decision", "accounting", "completed_at"
  ],
  "properties": {
    "schema_version": { "const": 4 },
    "kind": { "const": "codex-flow-task-terminal-receipt-v4" },
    "recipient": { "$ref": "#/$defs/recipient" },
    "executor_thread_id": { "$ref": "#/$defs/safeId" },
    "run_id": { "$ref": "#/$defs/safeId" },
    "runtime_context_digest": { "$ref": "#/$defs/digest" },
    "configuration_digest": { "$ref": "#/$defs/digest" },
    "repository_id": { "$ref": "#/$defs/safeId" },
    "common_dir": { "$ref": "#/$defs/absolutePath" },
    "plan_id": { "$ref": "#/$defs/safeId" },
    "revision_digest": { "$ref": "#/$defs/digest" },
    "task_id": { "$ref": "#/$defs/safeId" },
    "task_digest": { "$ref": "#/$defs/digest" },
    "contract_id": { "$ref": "#/$defs/digest" },
    "operation_id": { "$ref": "#/$defs/safeId" },
    "release_id": { "$ref": "#/$defs/safeId" },
    "task_launch": { "$ref": "#/$defs/taskLaunch" },
    "classification": { "enum": ["PASS", "BLOCKED", "FAIL"] },
    "git_outcome": { "$ref": "#/$defs/gitOutcome" },
    "model_evidence": { "$ref": "#/$defs/modelEvidence" },
    "result_or_blocker": { "type": "string", "minLength": 1, "maxLength": 512 },
    "next_decision": { "type": "string", "minLength": 1, "maxLength": 512 },
    "accounting": { "$ref": "#/$defs/accounting" },
    "completed_at": { "$ref": "#/$defs/timestamp" }
  },
  "allOf": [
    {
      "not": {
        "type": "object",
        "required": ["classification", "git_outcome"],
        "properties": {
          "classification": { "const": "PASS" },
          "git_outcome": {
            "type": "object",
            "required": ["kind"],
            "properties": { "kind": { "const": "dirty-blocked" } }
          }
        }
      }
    }
  ],
  "$defs": {
    "safeId": { "type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[A-Za-z0-9_.-]+$" },
    "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "commit": { "type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$" },
    "timestamp": { "type": "string", "format": "date-time", "maxLength": 64 },
    "absolutePath": { "type": "string", "minLength": 1, "maxLength": 2048, "pattern": "^/" },
    "nullableRef": { "oneOf": [{ "type": "null" }, { "type": "string", "minLength": 1, "maxLength": 256 }] },
    "selector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model", "reasoning_effort"],
      "properties": {
        "model": { "type": "string", "minLength": 1, "maxLength": 128 },
        "reasoning_effort": { "enum": ["none", "minimal", "low", "medium", "high", "xhigh", "max", "ultra"] }
      }
    },
    "recipient": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lineage_id", "thread_id", "generation", "binding_digest"],
      "properties": {
        "lineage_id": { "$ref": "#/$defs/safeId" },
        "thread_id": { "$ref": "#/$defs/safeId" },
        "generation": { "type": "integer", "minimum": 1, "maximum": 2147483647 },
        "binding_digest": { "$ref": "#/$defs/digest" }
      }
    },
    "taskLaunch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["launch_id", "state_digest", "identity_digest", "git_activation_digest"],
      "properties": {
        "launch_id": { "type": "string", "pattern": "^task-launch-v09-[0-9a-f]{64}$" },
        "state_digest": { "$ref": "#/$defs/digest" },
        "identity_digest": { "$ref": "#/$defs/digest" },
        "git_activation_digest": { "$ref": "#/$defs/digest" }
      }
    },
    "gitOutcome": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "baseline_revision", "final_revision", "branch", "upstream", "cleanliness"],
          "properties": {
            "kind": { "const": "unchanged" },
            "baseline_revision": { "$ref": "#/$defs/commit" },
            "final_revision": { "$ref": "#/$defs/commit" },
            "branch": { "$ref": "#/$defs/nullableRef" },
            "upstream": { "$ref": "#/$defs/nullableRef" },
            "cleanliness": { "const": "clean" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "baseline_revision", "commit", "branch", "upstream", "cleanliness"],
          "properties": {
            "kind": { "const": "clean-commit" },
            "baseline_revision": { "$ref": "#/$defs/commit" },
            "commit": { "$ref": "#/$defs/commit" },
            "branch": { "type": "string", "minLength": 1, "maxLength": 256 },
            "upstream": { "$ref": "#/$defs/nullableRef" },
            "cleanliness": { "const": "clean" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "baseline_revision", "commit", "branch", "upstream", "cleanliness", "status_digest"],
          "properties": {
            "kind": { "const": "dirty-blocked" },
            "baseline_revision": { "$ref": "#/$defs/commit" },
            "commit": { "$ref": "#/$defs/commit" },
            "branch": { "$ref": "#/$defs/nullableRef" },
            "upstream": { "$ref": "#/$defs/nullableRef" },
            "cleanliness": { "const": "dirty" },
            "status_digest": { "$ref": "#/$defs/digest" }
          }
        }
      ]
    },
    "modelEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["configured", "requested", "accepted", "observed"],
      "properties": {
        "configured": { "$ref": "#/$defs/selector" },
        "requested": { "$ref": "#/$defs/selector" },
        "accepted": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/selector" }] },
        "observed": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/selector" }] }
      }
    },
    "accounting": {
      "type": "object",
      "additionalProperties": false,
      "required": ["PRODUCT", "CROSS_CUTTING_PRODUCT_FIX", "ENVIRONMENT", "PROOF_HARNESS"],
      "properties": {
        "PRODUCT": { "type": "number", "minimum": 0 },
        "CROSS_CUTTING_PRODUCT_FIX": { "type": "number", "minimum": 0 },
        "ENVIRONMENT": { "type": "number", "minimum": 0 },
        "PROOF_HARNESS": { "type": "number", "minimum": 0 }
      }
    }
  }
}
