{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://private.local/codex-flow/task-packet.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "task_id", "run_id", "title", "objective", "role", "execution_kind", "launch_deadline", "baseline",
    "environment", "model", "reasoning_effort", "ownership", "dependencies",
    "shared_resources", "verification", "callback", "integration_gate", "cleanup_owner", "stop_policy"
  ],
  "properties": {
    "schema_version": { "const": 2 },
    "task_id": { "$ref": "#/$defs/safeId" },
    "run_id": { "$ref": "#/$defs/safeId" },
    "title": { "type": "string", "minLength": 1, "maxLength": 160 },
    "objective": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "role": { "enum": ["coordinator", "executor"] },
    "execution_kind": { "enum": ["task-thread", "subagent"] },
    "launch_deadline": { "$ref": "#/$defs/launchDeadline" },
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["revision", "cleanliness"],
      "properties": {
        "revision": { "type": "string", "minLength": 1, "maxLength": 256 },
        "cleanliness": { "enum": ["clean", "dirty-authorized"] }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "project_path"],
      "properties": {
        "type": { "enum": ["local", "worktree", "projectless"] },
        "project_path": {
          "description": "Absolute Git worktree root for local/worktree tasks; null for projectless tasks.",
          "oneOf": [
            { "type": "null" },
            { "type": "string", "minLength": 1, "maxLength": 1024 }
          ]
        }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "enum": ["local", "worktree"] } } },
          "then": { "properties": { "project_path": { "type": "string", "minLength": 1 } } }
        }
      ]
    },
    "model": {
      "oneOf": [
        { "type": "null" },
        { "type": "string", "minLength": 1, "maxLength": 128 }
      ]
    },
    "reasoning_effort": {
      "enum": [null, "none", "minimal", "low", "medium", "high", "xhigh", "max", "ultra"]
    },
    "ownership": {
      "type": "object",
      "additionalProperties": false,
      "required": ["write_paths", "read_paths", "exclusions"],
      "properties": {
        "write_paths": { "$ref": "#/$defs/nonemptyPaths" },
        "read_paths": { "$ref": "#/$defs/paths" },
        "exclusions": { "$ref": "#/$defs/paths" }
      }
    },
    "dependencies": { "$ref": "#/$defs/safeIds" },
    "shared_resources": { "$ref": "#/$defs/safeIds64" },
    "verification": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 512 }
    },
    "callback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["recipient", "executor_id", "receipt_schema_version"],
      "properties": {
        "recipient": {
          "type": "object",
          "additionalProperties": false,
          "required": ["lineage_id", "thread_id", "generation"],
          "properties": {
            "lineage_id": { "$ref": "#/$defs/safeId" },
            "thread_id": { "$ref": "#/$defs/safeId" },
            "generation": { "type": "integer", "minimum": 1, "maximum": 2147483647 }
          }
        },
        "executor_id": { "$ref": "#/$defs/safeId" },
        "receipt_schema_version": { "const": 2 }
      }
    },
    "integration_gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gate_id", "reproof"],
      "properties": {
        "gate_id": { "$ref": "#/$defs/safeId" },
        "reproof": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 512 }
        }
      }
    },
    "cleanup_owner": { "$ref": "#/$defs/safeId" },
    "stop_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["urgent", "ordinary_completion"],
      "properties": {
        "urgent": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "uniqueItems": true,
          "items": { "enum": ["blocker", "approval", "high-risk-drift"] }
        },
        "ordinary_completion": { "const": "queue" }
      }
    }
  },
  "$defs": {
    "safeId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_.-]+$"
    },
    "safeIds": {
      "type": "array",
      "maxItems": 128,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/safeId" }
    },
    "safeIds64": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/safeId" }
    },
    "launchDeadline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["at", "timezone"],
      "properties": {
        "at": {
          "type": "string",
          "minLength": 20,
          "maxLength": 64,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?(?:Z|[+-][0-9]{2}:[0-9]{2})$"
        },
        "timezone": { "type": "string", "minLength": 1, "maxLength": 128 }
      }
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^(?!\\.?$)(?!/)(?![A-Za-z]:/)(?!\\.git(?:/|$))(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*[*?\\[\\]{}]).+$"
    },
    "paths": {
      "type": "array",
      "maxItems": 128,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/path" }
    },
    "nonemptyPaths": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/path" }
    }
  }
}
