{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://private.local/codex-flow/task-packet.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "task_id", "title", "objective", "baseline",
    "environment", "model", "reasoning_effort", "ownership", "dependencies",
    "shared_resources", "verification", "callback", "stop_policy"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "task_id": { "$ref": "#/$defs/safeId" },
    "title": { "type": "string", "minLength": 1, "maxLength": 160 },
    "objective": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["revision", "cleanliness"],
      "properties": {
        "revision": { "type": "string", "minLength": 1, "maxLength": 256 },
        "cleanliness": { "enum": ["clean", "dirty-authorized"] }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "project_path"],
      "properties": {
        "type": { "enum": ["local", "worktree", "projectless"] },
        "project_path": {
          "oneOf": [
            { "type": "null" },
            { "type": "string", "minLength": 1, "maxLength": 1024 }
          ]
        }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "enum": ["local", "worktree"] } } },
          "then": { "properties": { "project_path": { "type": "string", "minLength": 1 } } }
        }
      ]
    },
    "model": {
      "oneOf": [
        { "type": "null" },
        { "type": "string", "minLength": 1, "maxLength": 128 }
      ]
    },
    "reasoning_effort": {
      "enum": [null, "none", "minimal", "low", "medium", "high", "xhigh", "max", "ultra"]
    },
    "ownership": {
      "type": "object",
      "additionalProperties": false,
      "required": ["write_paths", "read_paths", "exclusions"],
      "properties": {
        "write_paths": { "$ref": "#/$defs/nonemptyPaths" },
        "read_paths": { "$ref": "#/$defs/paths" },
        "exclusions": { "$ref": "#/$defs/paths" }
      }
    },
    "dependencies": { "$ref": "#/$defs/safeIds" },
    "shared_resources": { "$ref": "#/$defs/safeIds64" },
    "verification": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 512 }
    },
    "callback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["coordinator_thread_id", "executor_id"],
      "properties": {
        "coordinator_thread_id": { "$ref": "#/$defs/safeId" },
        "executor_id": { "$ref": "#/$defs/safeId" }
      }
    },
    "stop_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["urgent", "ordinary_completion"],
      "properties": {
        "urgent": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "uniqueItems": true,
          "items": { "enum": ["blocker", "approval", "high-risk-drift"] }
        },
        "ordinary_completion": { "const": "queue" }
      }
    }
  },
  "$defs": {
    "safeId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_.-]+$"
    },
    "safeIds": {
      "type": "array",
      "maxItems": 128,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/safeId" }
    },
    "safeIds64": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/safeId" }
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^(?!\\.?$)(?!/)(?![A-Za-z]:/)(?!\\.git(?:/|$))(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*[*?\\[\\]{}]).+$"
    },
    "paths": {
      "type": "array",
      "maxItems": 128,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/path" }
    },
    "nonemptyPaths": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/path" }
    }
  }
}
