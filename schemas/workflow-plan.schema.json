{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://private.local/codex-flow/workflow-plan.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "plan_id", "revision", "parent_revision_digest", "tasks", "revision_digest"],
  "properties": {
    "schema_version": { "const": 1 },
    "plan_id": { "$ref": "#/$defs/safeId" },
    "revision": { "type": "integer", "minimum": 1, "maximum": 2147483647 },
    "parent_revision_digest": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/digest" }] },
    "tasks": { "type": "array", "minItems": 1, "maxItems": 256, "items": { "$ref": "#/$defs/task" } },
    "revision_digest": { "$ref": "#/$defs/digest" }
  },
  "$defs": {
    "safeId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9_.-]+$" },
    "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "paths": {
      "type": "array", "maxItems": 128, "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 512 }
    },
    "forkTurns": {
      "oneOf": [
        { "const": "none" },
        { "type": "string", "pattern": "^[1-9][0-9]{0,5}$" }
      ]
    },
    "supportingFollowUp": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object", "additionalProperties": false,
          "required": ["kind", "task_id"],
          "properties": { "kind": { "const": "direct-attempt" }, "task_id": { "$ref": "#/$defs/safeId" } }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["kind", "reason"],
          "properties": { "kind": { "const": "pause-replan" }, "reason": { "type": "string", "minLength": 1, "maxLength": 512 } }
        }
      ]
    },
    "supportingAuthorization": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object", "additionalProperties": false,
          "required": ["authorized_revision", "reason"],
          "properties": {
            "authorized_revision": { "type": "integer", "minimum": 2, "maximum": 2147483647 },
            "reason": { "type": "string", "minLength": 1, "maxLength": 512 }
          }
        }
      ]
    },
    "task": {
      "type": "object", "additionalProperties": false,
      "required": [
        "task_id", "title", "execution_kind", "mode", "model", "reasoning_effort", "fork_turns",
        "dependencies", "read_paths", "write_paths", "shared_resources", "primary_outcome", "causal_question",
        "cheapest_safe_direct_attempt", "instrument_role", "supporting_follow_up", "supporting_authorization"
      ],
      "properties": {
        "task_id": { "$ref": "#/$defs/safeId" },
        "title": { "type": "string", "minLength": 1, "maxLength": 160 },
        "execution_kind": { "enum": ["task-thread", "subagent"] },
        "mode": { "enum": ["read", "write"] },
        "model": { "type": "string", "minLength": 1, "maxLength": 128 },
        "reasoning_effort": { "enum": ["none", "minimal", "low", "medium", "high", "xhigh", "max", "ultra"] },
        "fork_turns": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/forkTurns" }] },
        "dependencies": { "type": "array", "maxItems": 128, "uniqueItems": true, "items": { "$ref": "#/$defs/safeId" } },
        "read_paths": { "$ref": "#/$defs/paths" },
        "write_paths": { "$ref": "#/$defs/paths" },
        "shared_resources": {
          "type": "array", "maxItems": 128, "uniqueItems": true,
          "items": { "$ref": "#/$defs/safeId" }
        },
        "primary_outcome": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "causal_question": { "oneOf": [{ "type": "null" }, { "type": "string", "minLength": 1, "maxLength": 2000 }] },
        "cheapest_safe_direct_attempt": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "instrument_role": { "enum": ["none", "supporting", "primary-deliverable"] },
        "supporting_follow_up": { "$ref": "#/$defs/supportingFollowUp" },
        "supporting_authorization": { "$ref": "#/$defs/supportingAuthorization" }
      },
      "allOf": [
        {
          "if": { "properties": { "execution_kind": { "const": "subagent" } }, "required": ["execution_kind"] },
          "then": {
            "properties": {
              "mode": { "const": "read" },
              "reasoning_effort": { "enum": ["none", "minimal", "low", "medium", "high", "xhigh", "max"] },
              "write_paths": { "maxItems": 0 },
              "fork_turns": { "$ref": "#/$defs/forkTurns" }
            }
          },
          "else": { "properties": { "fork_turns": { "type": "null" } } }
        }
      ]
    },
    "planRevision": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "plan_id", "revision", "parent_revision_digest", "tasks", "revision_digest"],
      "properties": {
        "schema_version": { "const": 1 },
        "plan_id": { "$ref": "#/$defs/safeId" },
        "revision": { "type": "integer", "minimum": 1, "maximum": 2147483647 },
        "parent_revision_digest": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/digest" }] },
        "tasks": { "type": "array", "minItems": 1, "maxItems": 256, "items": { "$ref": "#/$defs/task" } },
        "revision_digest": { "$ref": "#/$defs/digest" }
      }
    }
  }
}
