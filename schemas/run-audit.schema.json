{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://private.local/codex-flow/run-audit.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "audit_id",
    "evidence_digest",
    "authority",
    "repository",
    "cleanup",
    "source_records",
    "blockers",
    "counts",
    "terminal_ready",
    "audited_at",
    "record_digest"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "kind": { "const": "codex-flow-v09-run-closure-audit" },
    "audit_id": {
      "type": "string",
      "pattern": "^run-closure-audit-v1-[0-9a-f]{64}$"
    },
    "evidence_digest": { "$ref": "#/$defs/digest" },
    "authority": { "$ref": "#/$defs/authority" },
    "repository": { "$ref": "#/$defs/repositoryEvidence" },
    "cleanup": { "$ref": "#/$defs/cleanupEvidence" },
    "source_records": {
      "type": "array",
      "maxItems": 100000,
      "items": { "$ref": "#/$defs/sourceRecord" }
    },
    "blockers": {
      "type": "array",
      "maxItems": 100000,
      "items": { "$ref": "#/$defs/blocker" }
    },
    "counts": { "$ref": "#/$defs/counts" },
    "terminal_ready": { "type": "boolean" },
    "audited_at": { "$ref": "#/$defs/timestamp" },
    "record_digest": { "$ref": "#/$defs/digest" }
  },
  "$defs": {
    "safeId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_.-]+$"
    },
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "timestamp": {
      "type": "string",
      "maxLength": 64,
      "format": "date-time"
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_id",
        "common_dir",
        "state_root",
        "runtime_id",
        "runtime_context_digest",
        "bundle_digest",
        "configuration_digest",
        "policy_digest",
        "repository_id",
        "repository_digest",
        "workflow_plan_id",
        "activated_revision_digest",
        "current_revision_digest",
        "workflow_journal_digest",
        "run_binding_generation",
        "run_binding_digest",
        "run_activation_digest"
      ],
      "properties": {
        "run_id": { "$ref": "#/$defs/safeId" },
        "common_dir": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "state_root": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "runtime_id": { "$ref": "#/$defs/digest" },
        "runtime_context_digest": { "$ref": "#/$defs/digest" },
        "bundle_digest": { "$ref": "#/$defs/digest" },
        "configuration_digest": { "$ref": "#/$defs/digest" },
        "policy_digest": { "$ref": "#/$defs/digest" },
        "repository_id": { "$ref": "#/$defs/safeId" },
        "repository_digest": { "$ref": "#/$defs/digest" },
        "workflow_plan_id": { "$ref": "#/$defs/safeId" },
        "activated_revision_digest": { "$ref": "#/$defs/digest" },
        "current_revision_digest": { "$ref": "#/$defs/digest" },
        "workflow_journal_digest": { "$ref": "#/$defs/digest" },
        "run_binding_generation": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "run_binding_digest": { "$ref": "#/$defs/digest" },
        "run_activation_digest": { "$ref": "#/$defs/digest" }
      }
    },
    "repositoryEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "root",
        "common_dir",
        "head_revision",
        "branch",
        "cleanliness",
        "expected_source",
        "expected_verification_id",
        "expected_root",
        "expected_common_dir",
        "expected_head_revision",
        "expected_branch"
      ],
      "properties": {
        "root": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "common_dir": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "head_revision": {
          "type": "string",
          "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
        },
        "branch": {
          "oneOf": [
            { "type": "null" },
            { "type": "string", "minLength": 1, "maxLength": 256 }
          ]
        },
        "cleanliness": { "enum": ["clean", "dirty"] },
        "expected_source": {
          "enum": ["activation-baseline", "combined-verification"]
        },
        "expected_verification_id": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "string",
              "pattern": "^verification-v1-[0-9a-f]{64}$"
            }
          ]
        },
        "expected_root": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "expected_common_dir": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "expected_head_revision": {
          "type": "string",
          "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
        },
        "expected_branch": {
          "oneOf": [
            { "type": "null" },
            { "type": "string", "minLength": 1, "maxLength": 256 }
          ]
        }
      }
    },
    "cleanupEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["plan_id", "mutation_performed", "counts"],
      "properties": {
        "plan_id": {
          "type": "string",
          "pattern": "^cleanup-plan-v1-[0-9a-f]{64}$"
        },
        "mutation_performed": { "const": false },
        "counts": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "host_worktree_tasks",
            "cleanup_required",
            "cleanup_candidates",
            "close_blocked"
          ],
          "properties": {
            "host_worktree_tasks": { "$ref": "#/$defs/count" },
            "cleanup_required": { "$ref": "#/$defs/count" },
            "cleanup_candidates": { "$ref": "#/$defs/count" },
            "close_blocked": { "$ref": "#/$defs/count" }
          }
        }
      }
    },
    "sourceRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["record_kind", "record_id", "source_locator", "record_digest"],
      "properties": {
        "record_kind": {
          "enum": [
            "run-activation",
            "runtime-context",
            "workflow-journal",
            "workflow-revision",
            "generated-task-contract",
            "task-launch",
            "subagent-operation",
            "callback",
            "disposition",
            "integration",
            "verification",
            "archive",
            "urgent-signal",
            "recipient-binding"
          ]
        },
        "record_id": { "type": "string", "minLength": 1, "maxLength": 256 },
        "source_locator": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "record_digest": { "$ref": "#/$defs/digest" }
      }
    },
    "blocker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "authority_kind", "authority_id", "task_id", "detail"],
      "properties": {
        "code": {
          "enum": [
            "workflow-journal-missing",
            "workflow-task-unclaimed",
            "current-unstarted-claim",
            "native-operation-missing",
            "task-launch-in-flight",
            "task-launch-ambiguous",
            "task-launch-session-blocked",
            "selector-replan-required",
            "selector-replan-exhausted",
            "subagent-incomplete",
            "callback-missing",
            "callback-unconsumed",
            "disposition-missing",
            "disposition-unfinalized",
            "integration-missing",
            "integration-unreconciled",
            "integration-unsafe",
            "verification-missing",
            "verification-not-pass",
            "archive-missing",
            "archive-incomplete",
            "retained-visible-task",
            "cleanup-unresolved",
            "urgent-unresolved",
            "recipient-binding-drift",
            "worktree-retained",
            "repository-dirty",
            "repository-drift",
            "orphaned-authority",
            "conflicting-authority"
          ]
        },
        "authority_kind": {
          "enum": [
            "run",
            "workflow",
            "claim",
            "task-launch",
            "subagent-operation",
            "callback",
            "disposition",
            "integration",
            "verification",
            "archive",
            "cleanup-plan",
            "urgent-signal",
            "recipient-binding"
          ]
        },
        "authority_id": { "type": "string", "minLength": 1, "maxLength": 256 },
        "task_id": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "pattern": "^[A-Za-z0-9_.-]+$"
            }
          ]
        },
        "detail": { "type": "string", "minLength": 1, "maxLength": 512 }
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workflow_tasks",
        "workflow_claims",
        "task_launches",
        "subagent_operations",
        "callbacks",
        "dispositions",
        "integrations",
        "verifications",
        "archives",
        "urgent_signals",
        "recipient_bindings"
      ],
      "properties": {
        "workflow_tasks": { "$ref": "#/$defs/count" },
        "workflow_claims": { "$ref": "#/$defs/count" },
        "task_launches": { "$ref": "#/$defs/count" },
        "subagent_operations": { "$ref": "#/$defs/count" },
        "callbacks": { "$ref": "#/$defs/count" },
        "dispositions": { "$ref": "#/$defs/count" },
        "integrations": { "$ref": "#/$defs/count" },
        "verifications": { "$ref": "#/$defs/count" },
        "archives": { "$ref": "#/$defs/count" },
        "urgent_signals": { "$ref": "#/$defs/count" },
        "recipient_bindings": { "$ref": "#/$defs/count" }
      }
    },
    "count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000000
    }
  }
}
