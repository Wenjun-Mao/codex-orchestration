{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://private.local/codex-flow/visible-task-creation.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "kind", "operation_id", "run_id",
    "runtime_context_digest", "configuration_digest", "repository_id",
    "common_dir", "coordinator_binding", "plan_id", "revision_digest",
    "task_id", "task_digest", "contract_id", "task_title",
    "launch_nonce", "bootstrap_digest", "selector_evidence", "status",
    "attempt", "provisional", "ready", "resolution", "prepared_at", "updated_at"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "kind": { "const": "codex-flow-v06-visible-task-creation" },
    "operation_id": {
      "type": "string",
      "pattern": "^visible-task-operation-v1-[0-9a-f]{64}$"
    },
    "run_id": { "$ref": "#/$defs/safeId" },
    "runtime_context_digest": { "$ref": "#/$defs/digest" },
    "configuration_digest": { "$ref": "#/$defs/digest" },
    "repository_id": { "$ref": "#/$defs/safeId" },
    "common_dir": { "type": "string", "minLength": 1, "maxLength": 2048 },
    "coordinator_binding": { "$ref": "#/$defs/coordinatorBinding" },
    "plan_id": { "$ref": "#/$defs/safeId" },
    "revision_digest": { "$ref": "#/$defs/digest" },
    "task_id": { "$ref": "#/$defs/safeId" },
    "task_digest": { "$ref": "#/$defs/digest" },
    "contract_id": { "$ref": "#/$defs/digest" },
    "task_title": { "type": "string", "minLength": 1, "maxLength": 160 },
    "launch_nonce": { "$ref": "#/$defs/digest" },
    "bootstrap_digest": { "$ref": "#/$defs/digest" },
    "selector_evidence": { "$ref": "#/$defs/selectorEvidence" },
    "status": {
      "enum": [
        "prepared", "attempting", "provisional", "ready-unreleased",
        "ambiguous", "not-created", "session-blocked"
      ]
    },
    "attempt": {
      "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/attempt" }]
    },
    "provisional": {
      "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/provisional" }]
    },
    "ready": {
      "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/ready" }]
    },
    "resolution": {
      "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/resolution" }]
    },
    "prepared_at": { "$ref": "#/$defs/timestamp" },
    "updated_at": { "$ref": "#/$defs/timestamp" }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "prepared" } } },
      "then": {
        "properties": {
          "attempt": { "type": "null" },
          "provisional": { "type": "null" },
          "ready": { "type": "null" },
          "resolution": { "type": "null" }
        }
      }
    },
    {
      "if": { "properties": { "status": { "const": "attempting" } } },
      "then": {
        "properties": {
          "attempt": { "$ref": "#/$defs/attempt" },
          "provisional": { "type": "null" },
          "ready": { "type": "null" },
          "resolution": { "type": "null" }
        }
      }
    },
    {
      "if": { "properties": { "status": { "const": "provisional" } } },
      "then": {
        "properties": {
          "attempt": { "$ref": "#/$defs/attempt" },
          "provisional": { "$ref": "#/$defs/provisional" },
          "ready": { "type": "null" },
          "resolution": { "type": "null" }
        }
      }
    },
    {
      "if": { "properties": { "status": { "const": "ready-unreleased" } } },
      "then": {
        "properties": {
          "attempt": { "$ref": "#/$defs/attempt" },
          "ready": { "$ref": "#/$defs/ready" },
          "resolution": { "type": "null" }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": { "enum": ["ambiguous", "not-created", "session-blocked"] }
        }
      },
      "then": {
        "properties": {
          "attempt": { "$ref": "#/$defs/attempt" },
          "ready": { "type": "null" },
          "resolution": { "$ref": "#/$defs/resolution" }
        }
      }
    }
  ],
  "$defs": {
    "safeId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_.-]+$"
    },
    "hostId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9_.-]+$"
    },
    "provisionalHostId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "revision": { "type": "string", "pattern": "^[0-9a-f]{40,64}$" },
    "timestamp": { "type": "string", "format": "date-time", "maxLength": 64 },
    "nullableSafeId": {
      "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/safeId" }]
    },
    "nullableText": {
      "oneOf": [
        { "type": "null" },
        { "type": "string", "minLength": 1, "maxLength": 128 }
      ]
    },
    "coordinatorBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lineage_id", "thread_id", "generation", "binding_digest"],
      "properties": {
        "lineage_id": { "$ref": "#/$defs/safeId" },
        "thread_id": { "$ref": "#/$defs/hostId" },
        "generation": { "type": "integer", "minimum": 1, "maximum": 2147483647 },
        "binding_digest": { "$ref": "#/$defs/digest" }
      }
    },
    "worktree": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "starting_revision", "starting_branch", "executor_branch", "path"],
      "properties": {
        "mode": { "enum": ["host-worktree", "local"] },
        "starting_revision": { "$ref": "#/$defs/revision" },
        "starting_branch": {
          "oneOf": [
            { "type": "null" },
            { "type": "string", "minLength": 1, "maxLength": 256 }
          ]
        },
        "executor_branch": {
          "oneOf": [
            { "type": "null" },
            { "type": "string", "minLength": 1, "maxLength": 256 }
          ]
        },
        "path": {
          "oneOf": [
            { "type": "null" },
            { "type": "string", "minLength": 1, "maxLength": 2048 }
          ]
        }
      }
    },
    "requestedSelectors": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project_id", "model", "reasoning_effort", "worktree"],
      "properties": {
        "project_id": { "$ref": "#/$defs/safeId" },
        "model": { "type": "string", "minLength": 1, "maxLength": 128 },
        "reasoning_effort": {
          "enum": ["none", "minimal", "low", "medium", "high", "xhigh", "max", "ultra"]
        },
        "worktree": { "$ref": "#/$defs/worktree" }
      }
    },
    "acceptedSelectors": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project_id", "model", "reasoning_effort", "worktree", "accepted_at"],
      "properties": {
        "project_id": { "$ref": "#/$defs/safeId" },
        "model": { "type": "string", "minLength": 1, "maxLength": 128 },
        "reasoning_effort": {
          "enum": ["none", "minimal", "low", "medium", "high", "xhigh", "max", "ultra"]
        },
        "worktree": { "$ref": "#/$defs/worktree" },
        "accepted_at": { "$ref": "#/$defs/timestamp" }
      }
    },
    "observedSelectors": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project_id", "model", "reasoning_effort", "worktree", "observed_at"],
      "properties": {
        "project_id": { "$ref": "#/$defs/nullableSafeId" },
        "model": { "$ref": "#/$defs/nullableText" },
        "reasoning_effort": {
          "oneOf": [
            { "type": "null" },
            { "enum": ["none", "minimal", "low", "medium", "high", "xhigh", "max", "ultra"] }
          ]
        },
        "worktree": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/worktree" }]
        },
        "observed_at": { "$ref": "#/$defs/timestamp" }
      }
    },
    "selectorEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requested", "accepted", "observed"],
      "properties": {
        "requested": { "$ref": "#/$defs/requestedSelectors" },
        "accepted": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/acceptedSelectors" }]
        },
        "observed": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/observedSelectors" }]
        }
      }
    },
    "attempt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["attempt_id", "host_session_id", "started_at", "reconcile_by"],
      "properties": {
        "attempt_id": {
          "type": "string",
          "pattern": "^visible-task-attempt-v1-[0-9a-f]{64}$"
        },
        "host_session_id": { "$ref": "#/$defs/safeId" },
        "started_at": { "$ref": "#/$defs/timestamp" },
        "reconcile_by": { "$ref": "#/$defs/timestamp" }
      }
    },
    "provisional": {
      "type": "object",
      "additionalProperties": false,
      "required": ["client_thread_id", "recorded_at"],
      "properties": {
        "client_thread_id": { "$ref": "#/$defs/provisionalHostId" },
        "recorded_at": { "$ref": "#/$defs/timestamp" }
      }
    },
    "initialTurn": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source", "thread_id", "turn_id", "turn_index", "role",
        "launch_nonce", "content_digest", "observed_at"
      ],
      "properties": {
        "source": { "const": "host-observed" },
        "thread_id": { "$ref": "#/$defs/hostId" },
        "turn_id": { "$ref": "#/$defs/hostId" },
        "turn_index": { "const": 1 },
        "role": { "const": "user" },
        "launch_nonce": { "$ref": "#/$defs/digest" },
        "content_digest": { "$ref": "#/$defs/digest" },
        "observed_at": { "$ref": "#/$defs/timestamp" }
      }
    },
    "ready": {
      "type": "object",
      "additionalProperties": false,
      "required": ["thread_id", "initial_turn", "recorded_at"],
      "properties": {
        "thread_id": { "$ref": "#/$defs/hostId" },
        "initial_turn": { "$ref": "#/$defs/initialTurn" },
        "recorded_at": { "$ref": "#/$defs/timestamp" }
      }
    },
    "resolution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outcome", "reason_code", "recorded_at"],
      "properties": {
        "outcome": { "enum": ["ambiguous", "not-created", "session-blocked"] },
        "reason_code": {
          "enum": [
            "host-result-ambiguous", "identity-evidence-missing", "selector-mismatch",
            "reconciliation-window-expired", "host-rejected-before-create",
            "create-returned-not-created", "argument-serialization",
            "adapter-unavailable", "backend-unavailable", "schema-runtime-drift",
            "host-control-failure"
          ]
        },
        "recorded_at": { "$ref": "#/$defs/timestamp" }
      }
    }
  }
}
