{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://private.local/codex-flow/runtime-bundle.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "package_version", "files", "bundle_sha256"],
  "properties": {
    "schema_version": { "const": 1 },
    "kind": { "const": "codex-flow-v07-runtime-bundle" },
    "package_version": { "type": "string", "minLength": 1, "maxLength": 128 },
    "files": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 2048,
      "propertyNames": {
        "pattern": "^(?:bin|lib|schemas|roles|references)/(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*\\\\).+$"
      },
      "additionalProperties": { "$ref": "#/$defs/digest" }
    },
    "bundle_sha256": { "$ref": "#/$defs/digest" }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
