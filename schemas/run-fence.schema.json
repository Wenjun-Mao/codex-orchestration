{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://private.local/codex-flow/run-fence.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "path_fences",
    "resource_fences",
    "branch_fences"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "kind": { "const": "codex-flow-v07-run-fence" },
    "path_fences": {
      "type": "array",
      "maxItems": 128,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512,
        "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.{1,2}(?:/|$)).+$"
      }
    },
    "resource_fences": {
      "type": "array",
      "maxItems": 128,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/safeId" }
    },
    "branch_fences": {
      "type": "array",
      "maxItems": 128,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256,
        "pattern": "^(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*\\\\)(?!.*\\s).+$"
      }
    }
  },
  "$defs": {
    "safeId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_.-]+$"
    }
  }
}
