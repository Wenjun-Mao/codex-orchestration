{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://private.local/codex-flow/terminal-receipt-v3.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "recipient", "executor_id", "run_id", "runtime_digest",
    "config_digest", "plan_id", "revision_id", "task_id",
    "task_contract_digest", "operation_id", "release_id", "classification",
    "git_outcome", "model_evidence", "result_or_blocker", "next_decision",
    "accounting", "completed_at"
  ],
  "properties": {
    "schema_version": { "const": 3 },
    "recipient": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lineage_id", "thread_id", "generation", "binding_digest"],
      "properties": {
        "lineage_id": { "$ref": "#/$defs/safeId" },
        "thread_id": { "$ref": "#/$defs/safeId" },
        "generation": { "type": "integer", "minimum": 1 },
        "binding_digest": { "$ref": "#/$defs/digest" }
      }
    },
    "executor_id": { "$ref": "#/$defs/safeId" },
    "run_id": { "$ref": "#/$defs/safeId" },
    "runtime_digest": { "$ref": "#/$defs/digest" },
    "config_digest": { "$ref": "#/$defs/digest" },
    "plan_id": { "$ref": "#/$defs/safeId" },
    "revision_id": { "$ref": "#/$defs/safeId" },
    "task_id": { "$ref": "#/$defs/safeId" },
    "task_contract_digest": { "$ref": "#/$defs/digest" },
    "operation_id": { "$ref": "#/$defs/safeId" },
    "release_id": { "$ref": "#/$defs/safeId" },
    "classification": { "enum": ["PASS", "BLOCKED", "FAIL"] },
    "git_outcome": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "baseline_revision", "final_revision", "branch", "upstream", "cleanliness"],
          "properties": {
            "kind": { "const": "unchanged" },
            "baseline_revision": { "$ref": "#/$defs/commit" },
            "final_revision": { "$ref": "#/$defs/commit" },
            "branch": { "$ref": "#/$defs/nullableRef" },
            "upstream": { "$ref": "#/$defs/nullableRef" },
            "cleanliness": { "const": "clean" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "baseline_revision", "commit", "branch", "upstream", "cleanliness"],
          "properties": {
            "kind": { "const": "clean-commit" },
            "baseline_revision": { "$ref": "#/$defs/commit" },
            "commit": { "$ref": "#/$defs/commit" },
            "branch": { "type": "string", "minLength": 1, "maxLength": 256 },
            "upstream": { "$ref": "#/$defs/nullableRef" },
            "cleanliness": { "const": "clean" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "baseline_revision", "commit", "branch", "upstream", "cleanliness", "status_digest"],
          "properties": {
            "kind": { "const": "dirty-blocked" },
            "baseline_revision": { "$ref": "#/$defs/commit" },
            "commit": { "$ref": "#/$defs/commit" },
            "branch": { "$ref": "#/$defs/nullableRef" },
            "upstream": { "$ref": "#/$defs/nullableRef" },
            "cleanliness": { "const": "dirty" },
            "status_digest": { "$ref": "#/$defs/digest" }
          }
        }
      ]
    },
    "model_evidence": { "$ref": "#/$defs/modelEvidence" },
    "result_or_blocker": { "type": "string", "minLength": 1, "maxLength": 512 },
    "next_decision": { "type": "string", "minLength": 1, "maxLength": 512 },
    "accounting": {
      "type": "object",
      "additionalProperties": false,
      "required": ["PRODUCT", "CROSS_CUTTING_PRODUCT_FIX", "ENVIRONMENT", "PROOF_HARNESS"],
      "properties": {
        "PRODUCT": { "type": "number", "minimum": 0 },
        "CROSS_CUTTING_PRODUCT_FIX": { "type": "number", "minimum": 0 },
        "ENVIRONMENT": { "type": "number", "minimum": 0 },
        "PROOF_HARNESS": { "type": "number", "minimum": 0 }
      }
    },
    "completed_at": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "safeId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_.-]+$"
    },
    "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "commit": { "type": "string", "pattern": "^[0-9a-f]{40,64}$" },
    "nullableRef": {
      "oneOf": [
        { "type": "null" },
        { "type": "string", "minLength": 1, "maxLength": 256 }
      ]
    },
    "selector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model", "reasoning_effort"],
      "properties": {
        "model": { "type": "string", "minLength": 1, "maxLength": 128 },
        "reasoning_effort": { "enum": ["none", "minimal", "low", "medium", "high", "xhigh", "max", "ultra"] }
      }
    },
    "modelEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["configured", "requested", "accepted", "observed"],
      "properties": {
        "configured": { "$ref": "#/$defs/selector" },
        "requested": { "$ref": "#/$defs/selector" },
        "accepted": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/selector" }]
        },
        "observed": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/selector" }]
        }
      }
    }
  }
}
