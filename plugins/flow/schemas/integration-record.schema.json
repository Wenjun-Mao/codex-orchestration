{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://private.local/codex-flow/integration-record.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "kind", "integration_id", "run_id",
    "runtime_context_digest", "configuration_digest", "repository_id",
    "common_dir", "coordinator_binding", "plan_id", "revision_digest",
    "task_id", "task_digest", "contract_id", "launch_id",
    "executor_thread_id", "launch_record_digest", "callback_id", "receipt_digest",
    "disposition_id", "disposition_record_digest", "main_branch",
    "executor_branch", "prepared_main_tip", "executor_tip",
    "state", "outcome",
    "reconciled_main_tip", "verification_id", "combined_verification_digest",
    "reconciliation_digest", "prepared_at", "reconciled_at"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "kind": { "const": "codex-flow-v09-serial-integration" },
    "integration_id": {
      "type": "string",
      "pattern": "^integration-v1-[0-9a-f]{64}$"
    },
    "run_id": { "$ref": "#/$defs/safeId" },
    "runtime_context_digest": { "$ref": "#/$defs/digest" },
    "configuration_digest": { "$ref": "#/$defs/digest" },
    "repository_id": { "$ref": "#/$defs/safeId" },
    "common_dir": { "type": "string", "minLength": 1, "maxLength": 2048 },
    "coordinator_binding": { "$ref": "#/$defs/coordinatorBinding" },
    "plan_id": { "$ref": "#/$defs/safeId" },
    "revision_digest": { "$ref": "#/$defs/digest" },
    "task_id": { "$ref": "#/$defs/safeId" },
    "task_digest": { "$ref": "#/$defs/digest" },
    "contract_id": { "$ref": "#/$defs/digest" },
    "launch_id": { "$ref": "#/$defs/safeId" },
    "executor_thread_id": { "$ref": "#/$defs/threadId" },
    "launch_record_digest": { "$ref": "#/$defs/digest" },
    "callback_id": { "$ref": "#/$defs/safeId" },
    "receipt_digest": { "$ref": "#/$defs/digest" },
    "disposition_id": { "$ref": "#/$defs/safeId" },
    "disposition_record_digest": { "$ref": "#/$defs/digest" },
    "main_branch": { "type": "string", "minLength": 1, "maxLength": 256 },
    "executor_branch": { "type": "string", "minLength": 1, "maxLength": 256 },
    "prepared_main_tip": { "$ref": "#/$defs/commit" },
    "executor_tip": { "$ref": "#/$defs/commit" },
    "state": { "enum": ["prepared", "reconciled"] },
    "outcome": { "$ref": "#/$defs/nullableOutcome" },
    "reconciled_main_tip": { "$ref": "#/$defs/nullableCommit" },
    "verification_id": { "$ref": "#/$defs/nullableVerificationId" },
    "combined_verification_digest": { "$ref": "#/$defs/nullableDigest" },
    "reconciliation_digest": { "$ref": "#/$defs/nullableDigest" },
    "prepared_at": { "$ref": "#/$defs/timestamp" },
    "reconciled_at": { "$ref": "#/$defs/nullableTimestamp" }
  },
  "allOf": [
    {
      "if": { "properties": { "state": { "const": "prepared" } } },
      "then": {
        "properties": {
          "outcome": { "type": "null" },
          "reconciled_main_tip": { "type": "null" },
          "verification_id": { "type": "null" },
          "combined_verification_digest": { "type": "null" },
          "reconciliation_digest": { "type": "null" },
          "reconciled_at": { "type": "null" }
        }
      },
      "else": {
        "required": ["outcome", "reconciled_main_tip", "reconciliation_digest", "reconciled_at"],
        "properties": {
          "outcome": { "$ref": "#/$defs/outcome" },
          "reconciled_main_tip": { "$ref": "#/$defs/commit" },
          "reconciliation_digest": { "$ref": "#/$defs/digest" },
          "reconciled_at": { "$ref": "#/$defs/timestamp" }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "outcome": { "enum": ["ancestor", "patch-equivalent"] }
              }
            },
            "then": {
              "properties": {
                "verification_id": { "$ref": "#/$defs/verificationId" },
                "combined_verification_digest": { "$ref": "#/$defs/digest" }
              }
            },
            "else": {
              "properties": {
                "verification_id": { "type": "null" },
                "combined_verification_digest": { "type": "null" }
              }
            }
          }
        ]
      }
    }
  ],
  "$defs": {
    "safeId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_.-]+$"
    },
    "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "coordinatorBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lineage_id", "thread_id", "generation", "binding_digest"],
      "properties": {
        "lineage_id": { "$ref": "#/$defs/safeId" },
        "thread_id": { "$ref": "#/$defs/threadId" },
        "generation": { "type": "integer", "minimum": 1, "maximum": 2147483647 },
        "binding_digest": { "$ref": "#/$defs/digest" }
      }
    },
    "threadId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9_.-]+$"
    },
    "verificationId": {
      "type": "string",
      "pattern": "^verification-v1-[0-9a-f]{64}$"
    },
    "commit": { "type": "string", "pattern": "^[0-9a-f]{40,64}$" },
    "outcome": {
      "enum": ["ancestor", "patch-equivalent", "unmerged"]
    },
    "nullableCommit": {
      "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/commit" }]
    },
    "nullableDigest": {
      "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/digest" }]
    },
    "nullableVerificationId": {
      "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/verificationId" }]
    },
    "nullableOutcome": {
      "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/outcome" }]
    },
    "timestamp": { "type": "string", "format": "date-time", "maxLength": 64 },
    "nullableTimestamp": {
      "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/timestamp" }]
    }
  }
}
