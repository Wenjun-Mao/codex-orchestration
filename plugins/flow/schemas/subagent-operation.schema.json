{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://private.local/codex-flow/subagent-operation.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "kind", "operation_id", "contract_id", "run_id",
    "runtime_context_digest", "configuration_digest", "repository_id", "common_dir",
    "coordinator_binding", "plan_id", "revision_digest", "task_id", "task_digest",
    "mode", "model", "reasoning_effort", "selector_rationale", "fork_turns", "prompt_digest",
    "initial_git_proof", "state", "attempt", "agent_id", "result", "coordinator_disposition",
    "prepared_at", "created_at", "completed_at", "disposed_at"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "kind": { "const": "codex-flow-native-subagent-operation" },
    "operation_id": { "type": "string", "pattern": "^subagent-operation-v1-[a-f0-9]{64}$" },
    "contract_id": { "$ref": "#/$defs/digest" },
    "run_id": { "$ref": "#/$defs/safeId" },
    "runtime_context_digest": { "$ref": "#/$defs/digest" },
    "configuration_digest": { "$ref": "#/$defs/digest" },
    "repository_id": { "$ref": "#/$defs/safeId" },
    "common_dir": { "type": "string", "minLength": 1, "maxLength": 2048 },
    "coordinator_binding": { "$ref": "#/$defs/coordinatorBinding" },
    "plan_id": { "$ref": "#/$defs/safeId" },
    "revision_digest": { "$ref": "#/$defs/digest" },
    "task_id": { "$ref": "#/$defs/safeId" },
    "task_digest": { "$ref": "#/$defs/digest" },
    "mode": { "const": "read" },
    "model": { "type": "string", "minLength": 1, "maxLength": 128 },
    "reasoning_effort": { "enum": ["none", "minimal", "low", "medium", "high", "xhigh", "max"] },
    "selector_rationale": { "type": "string", "minLength": 1, "maxLength": 512 },
    "fork_turns": { "$ref": "#/$defs/forkTurns" },
    "prompt_digest": { "$ref": "#/$defs/digest" },
    "initial_git_proof": { "$ref": "#/$defs/gitProof" },
    "state": {
      "enum": [
        "prepared", "attempting", "created", "selector-rejected-before-agent-identity",
        "ambiguous", "completed", "accepted", "rejected"
      ]
    },
    "attempt": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/attempt" }] },
    "agent_id": {
      "oneOf": [
        { "type": "null" },
        { "type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[A-Za-z0-9_.-]+$" }
      ]
    },
    "result": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/result" }] },
    "coordinator_disposition": { "enum": [null, "accepted", "rejected"] },
    "prepared_at": { "$ref": "#/$defs/timestamp" },
    "created_at": { "$ref": "#/$defs/nullableTimestamp" },
    "completed_at": { "$ref": "#/$defs/nullableTimestamp" },
    "disposed_at": { "$ref": "#/$defs/nullableTimestamp" }
  },
  "$defs": {
    "safeId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9_.-]+$" },
    "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "gitRevision": { "type": "string", "pattern": "^[a-f0-9]{40,64}$" },
    "timestamp": { "type": "string", "format": "date-time" },
    "nullableTimestamp": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/timestamp" }] },
    "forkTurns": {
      "oneOf": [
        { "const": "none" },
        { "type": "string", "pattern": "^[1-9][0-9]{0,5}$" }
      ]
    },
    "attempt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attempt_id", "started_at", "reconcile_by", "outcome",
        "ambiguity_reason", "reconciled_at"
      ],
      "properties": {
        "attempt_id": {
          "type": "string",
          "pattern": "^subagent-attempt-v1-[a-f0-9]{64}$"
        },
        "started_at": { "$ref": "#/$defs/timestamp" },
        "reconcile_by": { "$ref": "#/$defs/timestamp" },
        "outcome": {
          "enum": [null, "accepted", "selector-rejected-before-agent-identity", "ambiguous"]
        },
        "ambiguity_reason": {
          "enum": [null, "host-result-ambiguous", "reconciliation-window-expired"]
        },
        "reconciled_at": { "$ref": "#/$defs/nullableTimestamp" }
      }
    },
    "coordinatorBinding": {
      "type": "object", "additionalProperties": false,
      "required": ["lineage_id", "thread_id", "generation", "binding_digest"],
      "properties": {
        "lineage_id": { "$ref": "#/$defs/safeId" },
        "thread_id": { "type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[A-Za-z0-9_.-]+$" },
        "generation": { "type": "integer", "minimum": 1, "maximum": 2147483647 },
        "binding_digest": { "$ref": "#/$defs/digest" }
      }
    },
    "gitProof": {
      "type": "object", "additionalProperties": false,
      "required": ["root", "common_dir", "head", "branch", "head_ref", "head_ref_revision", "status_digest", "cleanliness"],
      "properties": {
        "root": { "type": "string", "minLength": 1, "maxLength": 2048 },
        "common_dir": { "type": "string", "minLength": 1, "maxLength": 2048 },
        "head": { "$ref": "#/$defs/gitRevision" },
        "branch": { "oneOf": [{ "type": "null" }, { "type": "string", "minLength": 1, "maxLength": 256 }] },
        "head_ref": { "oneOf": [{ "type": "null" }, { "type": "string", "minLength": 1, "maxLength": 512 }] },
        "head_ref_revision": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/gitRevision" }] },
        "status_digest": { "$ref": "#/$defs/digest" },
        "cleanliness": { "enum": ["clean", "dirty"] }
      }
    },
    "result": {
      "type": "object", "additionalProperties": false,
      "required": ["classification", "summary", "evidence_digests", "final_git_proof", "result_digest"],
      "properties": {
        "classification": { "enum": ["PASS", "BLOCKED", "FAIL"] },
        "summary": { "type": "string", "minLength": 1, "maxLength": 4000 },
        "evidence_digests": { "type": "array", "maxItems": 128, "uniqueItems": true, "items": { "$ref": "#/$defs/digest" } },
        "final_git_proof": { "$ref": "#/$defs/gitProof" },
        "result_digest": { "$ref": "#/$defs/digest" }
      }
    }
  }
}
