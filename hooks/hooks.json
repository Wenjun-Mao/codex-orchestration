{
  "description": "Capture one authenticated task final from either native root or thread-spawn completion.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$PLUGIN_ROOT/bin/codex-flow-report-launcher-install.mjs\"",
            "timeout": 3,
            "statusMessage": "Preparing authenticated task reporting"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$PLUGIN_ROOT/bin/codex-flow-report-launcher-install.mjs\"",
            "timeout": 3,
            "statusMessage": "Preparing authenticated task reporting"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$PLUGIN_DATA/report-hooks/launchers/report-hook-launcher-v1.mjs\"",
            "timeout": 3,
            "statusMessage": "Queueing authenticated task report"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$PLUGIN_DATA/report-hooks/launchers/report-hook-launcher-v1.mjs\"",
            "timeout": 3,
            "statusMessage": "Queueing authenticated task report"
          }
        ]
      }
    ]
  }
}
