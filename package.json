{
  "name": "@wjmao/codex-flow",
  "version": "0.9.1-rc.1",
  "description": "Dependency-free repository tooling for coordinated Codex task workflows.",
  "private": true,
  "type": "module",
  "bin": {
    "codex-flow": "./bin/codex-flow.mjs"
  },
  "scripts": {
    "test": "npm run test:v09",
    "test:v09": "node --test --test-concurrency=1 test/*-v09.test.mjs test/recipient.test.mjs test/release-identity.test.mjs",
    "validate": "node scripts/validate.mjs",
    "prepack": "node scripts/release-identity.mjs",
    "pack:check": "npm pack --dry-run"
  },
  "engines": {
    "node": ">=20.11"
  },
  "files": [
    ".codex-plugin/",
    "bin/",
    "lib/",
    "schemas/",
    "examples/",
    "skills/",
    "templates/",
    "docs/adr/",
    "docs/coverage-v0.9.md",
    "docs/architecture-v0.9.md",
    "docs/compatibility-capsules-v0.9.md",
    "docs/lessons-learned-v0.8.md",
    "docs/mission.md",
    "README.md"
  ],
  "license": "UNLICENSED"
}
