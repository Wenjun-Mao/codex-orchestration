{
  "name": "@wjmao/codex-flow",
  "version": "0.6.1-dev.0",
  "description": "Dependency-free repository tooling for coordinated Codex task workflows.",
  "private": true,
  "type": "module",
  "bin": {
    "codex-flow": "./bin/codex-flow.mjs"
  },
  "scripts": {
    "test": "npm run test:v06 && npm run test:v05.1",
    "test:v06": "node --test --test-concurrency=1 test/*-v06.test.mjs test/recipient.test.mjs test/release-identity.test.mjs test/urgent-signal.test.mjs",
    "test:v05.1": "node scripts/test-accepted-v05.mjs",
    "validate": "node scripts/validate.mjs",
    "prepack": "node scripts/release-identity.mjs",
    "pack:check": "npm pack --dry-run"
  },
  "engines": {
    "node": ">=20.11"
  },
  "files": [
    ".codex-plugin/",
    "bin/",
    "lib/",
    "schemas/",
    "examples/",
    "skills/",
    "templates/",
    "docs/",
    "README.md"
  ],
  "license": "UNLICENSED"
}
